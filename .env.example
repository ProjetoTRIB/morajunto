# ===== MoraJunto — Variáveis de Ambiente =====

# Servidor
PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/morajunto?retryWrites=true&w=majority

# JWT (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# Admin (usado apenas no seed inicial)
ADMIN_EMAIL=admin@morajunto.com.br
ADMIN_PASSWORD=
ADMIN_SEED_KEY=

# CORS (separar múltiplas origens com vírgula)
CORS_ORIGINS=http://localhost:3000

# Base URL do site (usado em emails, sitemap, SEO)
BASE_URL=http://localhost:3000

# Groq (IA para busca)
GROQ_API_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Cloudinary (upload de imagens)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Resend (envio de emails)
RESEND_API_KEY=
EMAIL_FROM=MoraJunto <noreply@morajunto.com.br>
